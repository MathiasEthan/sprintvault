{
  "name": "sprintvault",
  "version": "1.0.0",
  "description": "Task-governed Git wrapper for Scrum teams",
  "main": "server/src/index.ts",
  "scripts": {
    "start": "tsx server/src/index.ts",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev": "tsx watch server/src/index.ts",
    "test": "tsx server/test/workflow.test.ts"
  },
  "keywords": [
    "scrum",
    "git",
    "file-locking",
    "sprintvault"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
