# Copy to .env and adjust. All values are optional.

# Secret used to sign login tokens. If unset, a random secret is generated once
# and stored next to the database (.sprintvault-jwt-secret).
JWT_SECRET=

# true = show the 1-click demo login list and the user switcher (seeded password: password123).
# Never enable on a shared/production server.
DEMO_MODE=false

# Restrict "Import local directory" to these folders (separated by ; on Windows, : elsewhere).
IMPORT_ROOTS=

# Storage locations (defaults: ./sprintvault.db and ./repos)
DB_PATH=
REPOS_PATH=
PORT=3001
